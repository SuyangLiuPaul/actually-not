# 把这个文件复制成 .env.local，填上真实的值。
#
#   cp .env.example .env.local
#
# .env.local 已被 .gitignore 排除。可以自己确认一次：
#
#   git check-ignore -v .env.local
#
# 本仓库是公开的 —— 任何真实令牌都绝不能出现在被提交的文件里。

# Netlify 个人访问令牌
# 在 https://app.netlify.com/user/applications#personal-access-tokens 生成
# 注意：账号级令牌，能操作该账号下所有站点
NETLIFY_AUTH_TOKEN=nfp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 本项目的 Netlify 站点 ID（不是密钥）
NETLIFY_SITE_ID=1345bcb2-6a9c-4ec8-9ae0-f52cc3933551
